// LaLolla · schema do banco
//
// Regras de negócio que o schema PRECISA respeitar (ver DOCUMENTACAO.md do
// projeto antigo, seção 2):
//   2.1  custo da peça = codigoFornecedor × fator
//   2.2  o preço de venda NÃO mora no catálogo — é congelado no item da venda
//   2.3  código interno (SKU) ≠ código do fornecedor
//   2.4  estoque só muda por movimento, nunca por edição direta
//   2.10 venda não se apaga: cancela-se

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A URL nao mora mais aqui: o CLI do Prisma 7 le de prisma.config.ts,
  // e o runtime le de src/lib/prisma.ts (DATABASE_URL, porta 6543).
}

// ─────────────────────────── Pessoas ───────────────────────────

enum TipoPessoa {
  PF
  PJ
}

model Cliente {
  id   String @id @default(cuid())
  nome String

  // "pf" | "pj" — no app antigo o tipo troca rótulos (Nome/Razão social,
  // CPF/CNPJ) e habilita a busca na Receita. Trocar de tipo LIMPA o
  // documento: CPF não vira CNPJ.
  tipo     TipoPessoa @default(PF)
  fantasia String?
  doc      String?    @unique // só dígitos, sem máscara

  telefone   String?
  email      String?
  nascimento String? // "AAAA-MM-DD"; usado no filtro "Aniversariantes"

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  vendas     Venda[]
  orcamentos Orcamento[]

  @@index([nome])
  @@map("clientes")
}

model Fornecedor {
  id   String @id @default(cuid())
  nome String

  tipo     TipoPessoa @default(PJ)
  fantasia String?
  doc      String?    @unique

  telefone String?
  email    String?
  cidade   String?
  uf       String?

  observacoes String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pecas   Peca[]
  compras Compra[]
  contas  Conta[]

  @@index([nome])
  @@map("fornecedores")
}

// ─────────────────────────── Catálogo ───────────────────────────

enum TipoItem {
  PECA
  INSUMO
}

model Peca {
  id        String   @id @default(cuid())
  sku       String   @unique // código interno: LL-0001
  tipo      TipoItem @default(PECA)
  nome      String
  categoria String
  tamanho   String?

  // Regra 2.1. Os três campos são invisíveis para quem não tem a permissão
  // "financeiro" — o service os remove antes de devolver.
  codigoFornecedor Decimal? @db.Decimal(10, 2)
  fator            Decimal? @db.Decimal(10, 4)
  custo            Decimal? @db.Decimal(10, 2)

  precoTabela Decimal? @db.Decimal(10, 2)

  // Se for MENOR que o sugerido, passa a ser o preço usado na venda e aparece
  // na etiqueta como desconto ("DE" riscado e percentual).
  precoPromocional Decimal? @db.Decimal(10, 2)

  // Quanto já veio do fornecedor no total. É DIFERENTE do estoque atual:
  // sobe na entrada e desce na devolução ao fornecedor. É com ele que se
  // calcula o que ainda se deve por peças antigas, e é ele que define
  // "nunca comprada".
  totalRecebido Int @default(0)

  // Numeração por unidade na etiqueta: SKU-01, SKU-02… (peças iguais
  // recebem códigos diferentes para permitir rastreio individual).
  ultimaSerie Int @default(0)

  // Abaixo deste saldo a peça entra no filtro "Acabando" e ganha pílula.
  minimo Int @default(0)

  // Insumo é medido em unidade própria: un, cx, m, par. Vazio = "un".
  unidade String?

  // Pílula "A pagar" no catálogo: peça que entrou sem a compra quitada.
  pagoFornecedor Boolean @default(false)

  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  imagens    ImagemPeca[]
  movimentos MovimentoEstoque[]
  itensVenda ItemVenda[]
  itensOrcamento ItemOrcamento[]
  itensCompra    ItemCompra[]
  insumosVenda   InsumoVenda[]

  arquivada Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([categoria])
  @@index([nome])
  @@index([tipo, arquivada])
  @@map("pecas")
}

model ImagemPeca {
  id     String @id @default(cuid())
  pecaId String
  peca   Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  // Guardamos o CAMINHO no bucket, nunca a URL assinada (que expira).
  pathThumb    String
  pathMedia    String
  pathOriginal String

  largura   Int
  altura    Int
  bytes     Int
  principal Boolean @default(false)

  criadoEm DateTime @default(now())

  @@index([pecaId])
  @@map("imagens_peca")
}

// ─────────────────────────── Vendas ───────────────────────────

enum StatusVenda {
  ABERTA
  FECHADA
  CANCELADA // regra 2.10: venda não se apaga
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
}

model Venda {
  id     String      @id @default(cuid())
  numero Int         @unique @default(autoincrement())
  status StatusVenda @default(ABERTA)

  // A data do FATO, separada de criadoEm (a data do registro). A venda de
  // sábado lançada na segunda fatura no sábado — sem este campo o relatório
  // do mês, o caixa e a agenda usam "quando foi digitado", que é outra coisa.
  // O assistente pede esta data na etapa do cliente.
  data DateTime @default(now())

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  vendedorId String?
  vendedor   Usuario? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(10, 2)
  desconto Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  itens      ItemVenda[]
  pagamentos Pagamento[]
  insumos    InsumoVenda[]
  devolucoes Devolucao[]

  observacao String?

  canceladaEm     DateTime?
  motivoCancelada String?

  // Parcelas a receber. Uma venda a prazo gera Conta(tipo: RECEBER) — assim
  // "contas a receber" e "parcelas da venda" são a mesma coisa, e não duas
  // listas que precisam concordar entre si.
  parcelas Conta[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, criadoEm])
  @@index([clienteId])
  @@map("vendas")
}

model ItemVenda {
  id      String @id @default(cuid())
  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  pecaId  String
  peca    Peca   @relation(fields: [pecaId], references: [id])

  quantidade Int

  // Regra 2.2: preço CONGELADO no momento da venda. Se o catálogo mudar
  // amanhã, a venda de ontem continua valendo o que valia.
  precoUnit Decimal @db.Decimal(10, 2)

  // O CUSTO também congela. Sem isso a margem de uma venda de janeiro seria
  // recalculada com o custo de hoje — e o histórico mentiria a cada
  // atualização de preço do fornecedor.
  custoUnit Decimal? @db.Decimal(10, 2)

  // Quantas unidades voltaram. A devolução não apaga o item: abate do total
  // e devolve ao estoque, deixando o rastro de que a venda existiu.
  devolvido Int @default(0)

  // Série da peça vendida (SKU-01), quando houver etiqueta individual.
  serie String?

  devolucoes ItemDevolucao[]

  @@index([vendaId])
  @@map("itens_venda")
}

model Pagamento {
  id      String         @id @default(cuid())
  vendaId String
  venda   Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  forma   FormaPagamento
  valor   Decimal        @db.Decimal(10, 2)
  parcelas Int           @default(1)

  // Quando o dinheiro entrou. A tela de receber parcela tem campo de data, e
  // é por ela que o caixa agrupa o dia — não por quando alguém digitou.
  data DateTime @default(now())

  // Onde o dinheiro entrou. Sem isso o saldo da carteira ignoraria as vendas,
  // que são a maior entrada da loja.
  carteiraId String?
  carteira   Carteira? @relation(fields: [carteiraId], references: [id], onDelete: SetNull)

  // Pix, Débito e Crédito exigem comprovante. A PENDÊNCIA É DERIVADA daqui:
  // não existe campo "pendente" — quem precisa de comprovante e está com
  // comprovanteId nulo, está pendente. Um estado só, sem sincronizar nada.
  comprovanteId String?
  comprovante   Comprovante? @relation(fields: [comprovanteId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  @@index([vendaId])
  @@map("pagamentos")
}

// O que a loja gastou para entregar a venda: saquinho, caixinha, laço. Fica
// FORA de ItemVenda porque não é o que o cliente comprou — não tem preço, não
// sai no recibo e não entra no faturamento. Entra só no custo, reduzindo a
// margem. O custo congela aqui pelo mesmo motivo do item da venda.
model InsumoVenda {
  id      String @id @default(cuid())
  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  pecaId  String
  peca    Peca   @relation(fields: [pecaId], references: [id])

  quantidade Int
  custoUnit  Decimal @db.Decimal(10, 2)

  @@index([vendaId])
  @@map("insumos_venda")
}

// Abater do saldo ou devolver o dinheiro — são caminhos diferentes no caixa.
enum ResolucaoDevolucao {
  ABATER // reduz o saldo que o cliente ainda deve
  DEVOLVER // sai dinheiro do caixa, categoria Devolução
}

// A devolução não apaga o item da venda: abate do total, devolve a peça ao
// estoque e deixa o rastro de que a venda existiu. Precisa de cabeçalho
// próprio porque a data, o motivo e a forma de resolver são da devolução,
// não da venda.
model Devolucao {
  id      String @id @default(cuid())
  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  data      DateTime
  motivo    String?
  resolucao ResolucaoDevolucao
  total     Decimal            @db.Decimal(10, 2)

  // Só quando o valor volta para o cliente: a saída de caixa que isso gerou.
  lancamentoId String? @unique

  itens ItemDevolucao[]

  criadoEm DateTime @default(now())

  @@index([vendaId])
  @@map("devolucoes")
}

model ItemDevolucao {
  id          String    @id @default(cuid())
  devolucaoId String
  devolucao   Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)

  itemVendaId String
  itemVenda   ItemVenda @relation(fields: [itemVendaId], references: [id], onDelete: Cascade)

  quantidade Int
  precoUnit  Decimal @db.Decimal(10, 2)

  @@index([devolucaoId])
  @@map("itens_devolucao")
}

model Comprovante {
  id       String   @id @default(cuid())
  path     String // bucket PRIVADO — documento financeiro
  mimeType String
  bytes    Int
  criadoEm DateTime @default(now())

  pagamentos  Pagamento[]
  lancamentos Lancamento[]

  @@map("comprovantes")
}

// ─────────────────────────── Orçamentos ───────────────────────────

enum StatusOrcamento {
  ABERTO
  CONVERTIDO // virou venda (regra 2.5: trava depois disso)
  RECUSADO // o cliente disse não — dá para reabrir
  SUBSTITUIDO // uma revisão tomou o lugar dele
}

// Como o cliente vai pagar, quando isso já foi combinado. "A combinar" é o
// padrão e faz o PDF sair só com os valores, para negociar.
enum ModoPagamentoOrcamento {
  A_COMBINAR
  A_VISTA
  PARCELADO
}

model Orcamento {
  id     String          @id @default(cuid())
  numero Int             @unique @default(autoincrement())
  status StatusOrcamento @default(ABERTO)

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(10, 2)
  desconto Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  data DateTime @default(now())

  // Guardamos os DIAS, não só a data final: é o que a tela pergunta (3, 7, 15
  // ou 30) e o que permite recalcular a validade se a data do orçamento mudar.
  // validoAte continua gravado para a consulta não ter que fazer conta.
  validadeDias Int       @default(7)
  validoAte    DateTime?

  vendaId String? @unique // preenchido quando converte

  // Revisão: nasce um orçamento NOVO, com número novo e os mesmos itens, e o
  // anterior fica SUBSTITUIDO. Nada é editado no lugar — o PDF que o cliente
  // já recebeu precisa continuar existindo do jeito que foi enviado.
  revisaoDeId     String?     @unique
  revisaoDe       Orcamento?  @relation("revisao", fields: [revisaoDeId], references: [id], onDelete: SetNull)
  substituidoPor  Orcamento?  @relation("revisao")

  modoPagamento ModoPagamentoOrcamento @default(A_COMBINAR)
  formaPagamento FormaPagamento?
  parcelas       Int?
  primeiroVencimento DateTime?

  // Texto livre que SAI no PDF: condições, prazo de entrega, forma de envio.
  observacao String?

  itens ItemOrcamento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, data])
  @@map("orcamentos")
}

model ItemOrcamento {
  id          String    @id @default(cuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  pecaId      String
  peca        Peca      @relation(fields: [pecaId], references: [id])

  quantidade Int
  precoUnit  Decimal @db.Decimal(10, 2)

  @@index([orcamentoId])
  @@map("itens_orcamento")
}

// ─────────────────────────── Estoque ───────────────────────────

enum MotivoMovimento {
  COMPRA
  VENDA
  DEVOLUCAO
  AJUSTE
  INVENTARIO
  PERDA
}

model MovimentoEstoque {
  id     String @id @default(cuid())
  pecaId String
  peca   Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  // Regra 2.4: o saldo é a SOMA dos deltas, nunca um campo editável.
  // + entrada, − saída.
  delta  Int
  motivo MotivoMovimento
  origem String? // id da venda/compra que gerou

  // A entrada de mercadoria e o ajuste de inventário pedem a data em que a
  // coisa aconteceu: a nota é de terça, o app foi aberto na quinta.
  data DateTime @default(now())

  observacao String?
  criadoEm   DateTime @default(now())

  @@index([pecaId, data])
  @@map("movimentos_estoque")
}

// ─────────────────────────── Compras ───────────────────────────

model Compra {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])

  total      Decimal   @db.Decimal(10, 2)
  aPrazo     Boolean   @default(false)
  vencimento DateTime?
  observacao String?

  // "Data do pedido", a primeira pergunta do assistente de compra. É por ela
  // que o Portal de compras agrupa os meses.
  data DateTime @default(now())

  itens   ItemCompra[]
  // Regra 2.12: dar entrada em peça É saída de caixa. À vista vira lançamento,
  // a prazo vira conta a pagar. Uma compra nunca fica sem rastro no dinheiro.
  parcelas Conta[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([fornecedorId, criadoEm])
  @@map("compras")
}

model ItemCompra {
  id       String @id @default(cuid())
  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)
  pecaId   String
  peca     Peca   @relation(fields: [pecaId], references: [id])

  quantidade Int
  custoUnit  Decimal @db.Decimal(10, 2)

  @@index([compraId])
  @@map("itens_compra")
}

// ─────────────────────────── Financeiro ───────────────────────────

enum TipoConta {
  PAGAR
  RECEBER
}

enum StatusConta {
  ABERTA
  PAGA
  CANCELADA
}

model Conta {
  id     String      @id @default(cuid())
  tipo   TipoConta
  status StatusConta @default(ABERTA)

  descricao  String
  valor      Decimal  @db.Decimal(10, 2)
  vencimento DateTime

  // A tela de fornecedores soma as contas em aberto de cada um.
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  // Quando a conta é parcela de uma venda a prazo.
  vendaId String?
  venda   Venda?  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  // Quando é parcela de uma compra do fornecedor.
  compraId String?
  compra   Compra? @relation(fields: [compraId], references: [id], onDelete: Cascade)
  parcela Int?    // 1 de 3, 2 de 3...
  deParcelas Int?

  // Compra no crédito: a parcela vira conta na fatura do cartão e consome
  // limite. Todas as contas do MESMO cartão que vencem no MESMO dia são uma
  // fatura só — ninguém paga uma compra do cartão, paga a fatura.
  cartaoId   String?
  cartao     Carteira? @relation("cartao", fields: [cartaoId], references: [id], onDelete: SetNull)
  dataCompra DateTime? // quando a compra foi feita, não quando a fatura vence

  pagoEm    DateTime?
  // Na baixa de vencimento o comprovante é OBRIGATÓRIO (diferente da venda,
  // onde ele é pendência). A regra vive no service, não no banco.
  lancamentoId String?  @unique
  lancamento   Lancamento? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tipo, status, vencimento])
  @@map("contas")
}

// Onde o dinheiro está. CARTAO é a exceção que confirma a regra: ele não
// guarda dinheiro nenhum — guarda quanto ainda dá para gastar. Por isso fica
// fora do saldo do caixa e fora de todo lugar onde se escolhe de onde o
// dinheiro saiu; no crédito o dinheiro só sai no dia em que a fatura é paga.
enum TipoCarteira {
  ESPECIE // a gaveta
  CONTA // conta do banco
  RESERVA // o antigo "cofrinho"
  CARTAO // cartão de crédito da loja
  OUTRA
}

model Carteira {
  id    String       @id @default(cuid())
  nome  String       @unique
  tipo  TipoCarteira @default(CONTA)
  ordem Int          @default(0)

  // ---- só para tipo CARTAO ----
  limite        Decimal? @db.Decimal(10, 2)
  // Quanto do limite já estava comprometido antes de a loja usar o app.
  usadoInicial  Decimal  @default(0) @db.Decimal(10, 2)
  diaFechamento Int? // opcional: sem ele, vale o próximo vencimento
  diaVencimento Int? // padrão 10 na tela
  validade      String? // "AAAA-MM", como vem do <input type="month">

  contasCartao Conta[] @relation("cartao")

  // Quanto já havia na carteira quando ela foi criada. Sem isso, o saldo
  // começaria em zero e só bateria com a realidade depois de meses.
  saldoInicial Decimal @default(0) @db.Decimal(10, 2)

  // Carteira é ONDE o dinheiro está (espécie, banco, reserva) — NÃO é como
  // o cliente pagou (Pix, débito). São eixos diferentes: um Pix cai no
  // banco, um crédito também, e dinheiro vivo fica na espécie.
  arquivada Boolean @default(false)

  lancamentos       Lancamento[]
  pagamentos        Pagamento[]
  transferenciasSai Transferencia[] @relation("origem")
  transferenciasEnt Transferencia[] @relation("destino")

  criadoEm DateTime @default(now())

  @@map("carteiras")
}

model Lancamento {
  id String @id @default(cuid())

  // Opcional de propósito: o app antigo permite lançar dinheiro sem dizer
  // onde ele está, e mostra o total como "sem carteira" para a pessoa
  // revisar depois. Obrigar aqui faria a tela mentir ou travar o lançamento.
  carteiraId String?
  carteira   Carteira? @relation(fields: [carteiraId], references: [id], onDelete: SetNull)

  descricao String
  valor     Decimal @db.Decimal(10, 2) // + entrada, − saída
  categoria String?

  // O dia em que o dinheiro se moveu. Duas regras dependem dele e nenhuma
  // funciona com criadoEm: lançar um frete de ontem, e "valor com data no
  // futuro só entra no saldo naquele dia" (o app avisa e deixa gravar).
  data DateTime @default(now())

  comprovanteId String?
  comprovante   Comprovante? @relation(fields: [comprovanteId], references: [id], onDelete: SetNull)

  conta Conta?

  criadoEm DateTime @default(now())

  @@index([carteiraId, data])
  @@map("lancamentos")
}

model Transferencia {
  id        String   @id @default(cuid())
  origemId  String
  origem    Carteira @relation("origem", fields: [origemId], references: [id])
  destinoId String
  destino   Carteira @relation("destino", fields: [destinoId], references: [id])

  valor Decimal @db.Decimal(10, 2)

  // Mesma razão das outras datas: o saldo de cada carteira conta só o que já
  // aconteceu até hoje, e uma transferência datada para amanhã não pode
  // aparecer no saldo de agora.
  data       DateTime @default(now())
  observacao String?

  criadoEm DateTime @default(now())

  @@map("transferencias")
}

// ─────────────────────────── Usuários ───────────────────────────

enum Papel {
  SUPER_ADMIN // joao, hemily — não podem ser rebaixados nem excluídos
  ADMIN
  VENDEDOR
}

model Usuario {
  id    String @id @default(cuid())
  email String @unique
  nome  String
  papel Papel  @default(VENDEDOR)

  // { pecas: {ver,criar,editar,excluir}, vendas: {...}, ... }
  // ADMIN e SUPER_ADMIN ignoram este campo: têm tudo, sempre.
  permissoes Json @default("{}")

  // null = primeiro acesso: a primeira senha digitada vira a senha dele.
  senhaHash String?
  ativo     Boolean @default(true)

  sessoes Sessao[]
  vendas  Venda[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // SHA-256 do token, nunca o token em texto. Quem tiver o banco não
  // consegue se passar por um usuário logado.
  tokenHash String   @unique
  expiraEm  DateTime

  // A sessão cai por INATIVIDADE: 3 dias sem uso, como manda a documentação
  // funcional. Cada requisição autenticada empurra este carimbo para a
  // frente; `expiraEm` continua como teto absoluto.
  ultimoUso DateTime @default(now())

  ip        String?
  userAgent String?

  criadoEm DateTime @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

model TentativaLogin {
  id       String   @id @default(cuid())
  chave    String // "email|ip"
  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
  @@map("tentativas_login")
}

// ─────────────────────────── Config e auditoria ───────────────────────────

model Config {
  chave String @id
  valor Json

  atualizadoEm DateTime @updatedAt

  @@map("config")
}

model Evento {
  id        String   @id @default(cuid())
  tipo      String
  usuarioId String?
  entidade  String?
  entidadeId String?
  dados     Json?
  criadoEm  DateTime @default(now())

  @@index([criadoEm])
  @@index([entidade, entidadeId])
  @@map("eventos")
}
