# ═══════════════════════════════════════════════════════════════
#  LaLolla · modelo de variáveis de ambiente
#  Copie para .env e preencha. O .env NUNCA vai para o Git.
# ═══════════════════════════════════════════════════════════════

# ── Banco (Prisma + Supabase) ──────────────────────────────────
#
# DATABASE_URL  → pooler em modo TRANSACTION, porta 6543. É a que a
#   aplicação usa em runtime.
#   · pgbouncer=true       obrigatório: sem isso o Prisma usa prepared
#                          statements que o PgBouncer não suporta, e a app
#                          quebra de forma intermitente (o pior tipo de bug).
#   · connection_limit=1   herança do motor antigo do Prisma; com o adapter
#                          `pg` quem manda é o `max` em src/lib/prisma.ts:
#                          5 por instância na Vercel, 10 fora dela.
#
# REGIÃO IMPORTA MAIS DO QUE PARECE: com o banco no Canadá cada consulta
# custava 150 ms de ida e volta; em São Paulo custa 23 ms. A tela de Início
# faz ~14 consultas — 2,1 s contra 0,3 s, só de distância.
#
# DIRECT_URL    → pooler em modo SESSION, porta 5432. Usada só por
#   `prisma migrate` (DDL precisa de conexão estável, que o modo transaction
#   não dá). Não precisa existir no runtime de produção.
#
# Senha com caractere especial precisa de URL-encode:
#   ]  → %5D      @ → %40      #  → %23      /  → %2F
#
DATABASE_URL="postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres"

# ── Supabase (Storage) ─────────────────────────────────────────
#
# Tudo que começa com NEXT_PUBLIC_ é EMBUTIDO no JavaScript enviado ao
# navegador. Qualquer visitante lê. Só coloque aí o que pode ser público.
#
NEXT_PUBLIC_SUPABASE_URL="https://<REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key — pública, protegida por RLS>"

# A service role IGNORA todas as políticas de segurança do banco.
# Vazar esta chave = perder o banco. Só no servidor, nunca com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service role — SEGREDO>"

# ── Aplicação ──────────────────────────────────────────────────
# Assina o cookie de sessão. Gere com:  openssl rand -base64 32
SESSION_SECRET="<32+ bytes aleatórios>"

# Tamanho mínimo de senha. Subir este número é a defesa mais barata que
# existe para um app exposto na internet.
MIN_SENHA="10"

# ── Assistente IA (somente servidor) ───────────────────────────
# Ordem de tentativa. Sem chave E modelo válidos, o provedor é ignorado.
# Sem provedores configurados, a opção IA fica oculta.
# Modelos não possuem fallback fixo no código: escolha um disponível na conta.
# Groq: https://console.groq.com/ (serviço diferente de Grok/xAI).
GROQ_API_KEY=""
GROQ_MODEL=""
# Opcional: Grok/xAI, somente se incluir grok em ASSISTENTE_PROVEDORES.
# https://console.x.ai/
GROK_API_KEY=""
GROK_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
ASSISTENTE_PROVEDORES="groq,gemini"
ASSISTENTE_TIMEOUT_CHAMADA_MS="15000"
ASSISTENTE_TIMEOUT_TOTAL_MS="60000"
ASSISTENTE_COOLDOWN_MS="30000"
ASSISTENTE_MAX_RODADAS="4"
ASSISTENTE_MAX_FERRAMENTAS="12"
ASSISTENTE_MENSAGENS_POR_MINUTO="10"
ASSISTENTE_MAX_TOKENS="2000"
# Cooldown e rate limit são locais ao processo, não compartilhados em serverless.
# Configure o tempo máximo da hospedagem acima do timeout total (+ margem).
