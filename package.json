    "db:deploy": "prisma migrate deploy && prisma generate && node scripts/avisar-reinicio.mjs",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "testar:banco": "node --env-file=.env --import tsx scripts/testar-prisma.ts",
    "verificar": "node --env-file=.env --import tsx scripts/verificar-vertical.ts",
    "icones": "node scripts/gerar-icones.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
